name: @@WORKFLOW_NAME@@

on:
  push:
    branches: [main]
    paths:
      - @@SOURCE_ROOT_PATH@@
@@EXPORT_WATCH_PATHS@@      - @@EXPORT_SCRIPT_PATH@@
      - @@IMPORT_SCRIPT_PATH@@
      # Every copy.barista.toml excludes these, so a push touching only a
      # private path exports an identical tree -- a runner minute spent to
      # produce no diff. Negatives must stay LAST: GitHub applies patterns in
      # order and a later positive re-includes the path.
      - "!**/*private*"
      - "!**/*private*/**"
  workflow_dispatch:
    inputs:
      replay_bootstrap_base:
        description: >-
          One-shot source revision used as the PR-metadata replay base when the
          public export branch has no marker (delete the branch first). Skips
          replaying commits at or before this revision.
        required: false
        default: ""

permissions:
  contents: read
  pull-requests: read
  # The export waits for a sibling export of the same commit before locking.
  actions: read

concurrency:
  group: copybarista-export-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  export-pr:
    name: @@JOB_NAME@@
    runs-on: ubuntu-latest
    # Bounded so a hung step fails in minutes, not at the 6h default.
    timeout-minutes: 45
    env:
@@EXPORT_JOB_TOKEN_ENV@@      COPYBARISTA_ACTIONS_TOKEN: ${{ github.token }}
      TARGET_REPO: @@PUBLIC_REPO@@
      BASE_BRANCH: main
      EXPORT_BRANCH: @@EXPORT_BRANCH@@
      SYNC_LABEL: @@SYNC_LABEL@@
      FORBIDDEN_PR_TEXT: @@FORBIDDEN_PR_TEXT@@
      COPYBARISTA_SYNC_USER_NAME: @@SYNC_USER_NAME@@
      COPYBARISTA_SYNC_USER_EMAIL: @@SYNC_USER_EMAIL@@
@@SYNC_LOGIN_ENV@@      COPYBARISTA_AUTO_MERGE: ${{ vars.COPYBARISTA_AUTO_MERGE || 'false' }}
@@REPLAY_BOOTSTRAP_BASE_COMMENT@@      COPYBARISTA_REPLAY_BOOTSTRAP_BASE: ${{ inputs.replay_bootstrap_base@@REPLAY_BOOTSTRAP_BASE_DEFAULT@@ }}

    steps:
@@SYNC_AUTH_STEPS@@      - uses: @@USES_CHECKOUT@@
        with:
          path: source
          fetch-depth: 0
      - uses: @@USES_SETUP_PYTHON@@
        with:
          # Pin to the published floor (requires-python >=3.12), not the repo
          # default, so the export runs on the oldest interpreter downstream
          # users can install.
          python-version: @@PYTHON_VERSION@@
      - uses: @@USES_SETUP_UV@@
        with:
          working-directory: source
          # Outranks the source checkout's .python-version, which pins a newer one.
          python-version: @@PYTHON_VERSION@@
          # The export installs three small tools. setup-uv's default cache key
          # hashes the source's lock files, so it would restore the source repo's
          # full-environment uv cache, which can outgrow the runner's disk.
          enable-cache: false
      - uses: @@USES_CHECKOUT@@
        with:
          repository: ${{ env.TARGET_REPO }}
          token: @@SYNC_TOKEN@@
          ref: ${{ env.BASE_BRANCH }}
          path: public
          # Full history: the data-loss guard walks `<last-import>..HEAD` to see
          # whether anything unimported was written by someone other than the
          # export. A shallow clone cannot resolve that range, so the guard
          # fails closed and every export skips forever.
          fetch-depth: 0
@@SYSTEM_DEPS@@      - name: Open export PR
        env:
@@EXPORT_STEP_TOKEN_ENV@@          PYTHONPATH: source
        run: |
          uv --quiet run --no-project --with pyyaml --with rignore --with ruff --with tomlkit --with treekle \
            python3 \
            @@SYNC_EXPORT_SCRIPT@@ \
            --source-dir source \
            --project-path @@SOURCE_ROOT@@ \
            --public-dir public \
            --target-repo "$TARGET_REPO" \
            --base-branch "$BASE_BRANCH" \
            --branch "$EXPORT_BRANCH" \
            --branch-prefix @@EXPORT_BRANCH_PREFIX@@ \
            --import-branch-prefix @@IMPORT_BRANCH_PREFIX@@ \
            --source-repo "${{ github.repository }}" \
            --sync-label "$SYNC_LABEL" \
@@PR_REPLAY_FLAGS@@ \
            --forbidden-pr-text "$FORBIDDEN_PR_TEXT" \
@@RELEASE_CHECK_ARG@@@@TYPE_TARGETS@@ \
@@VALIDATION_COMMANDS@@ \
@@SMOKE_IMPORT_ARG@@@@SKIP_SOURCE_VALIDATION_ARG@@            --auto-merge="$COPYBARISTA_AUTO_MERGE"
