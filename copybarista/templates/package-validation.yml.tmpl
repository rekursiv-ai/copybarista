name: Package validation

on:
  pull_request:
    branches: [main]
    paths:
      - "**"
  push:
    branches: [main]
    paths:
      - "**"

permissions:
  contents: read

concurrency:
  group: package-validation-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    name: @@VALIDATE_JOB_NAME@@
    runs-on: ubuntu-latest
    # Bounded so a hung step fails in minutes, not at the 6h default.
    timeout-minutes: 45
@@STRATEGY@@    steps:
      - uses: @@USES_CHECKOUT@@
      - uses: @@USES_SETUP_PYTHON@@
        with:
@@PYTHON_SETUP@@
      - uses: @@USES_SETUP_UV@@
        with:
          # Outranks the checkout's .python-version, which pins a newer one.
@@PYTHON_SETUP@@
@@SYSTEM_DEPS@@      - name: Validate package
        # The same for every package; a package's own checks are its tests.
        run: |
@@CI_COMMANDS@@@@MATRIX_GATE@@
