name: @@WORKFLOW_NAME@@

on:
  push:
    branches: [main]
    paths:
      - @@SOURCE_ROOT_PATH@@
@@EXPORT_WATCH_PATHS@@      - @@EXPORT_SCRIPT_PATH@@
      - @@IMPORT_SCRIPT_PATH@@
  workflow_dispatch:
    inputs:
      replay_bootstrap_base:
        description: >-
          One-shot source revision used as the PR-metadata replay base when the
          public export branch has no marker (delete the branch first). Skips
          replaying commits at or before this revision.
        required: false
        default: ""

permissions:
  contents: read

concurrency:
  group: copybarista-export-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  export-pr:
    name: @@JOB_NAME@@
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ secrets.COPYBARISTA_SYNC_TOKEN }}
      TARGET_REPO: @@PUBLIC_REPO@@
      BASE_BRANCH: main
      EXPORT_BRANCH: @@EXPORT_BRANCH@@
      SYNC_LABEL: @@SYNC_LABEL@@
      FORBIDDEN_PR_TEXT: @@FORBIDDEN_PR_TEXT@@
      COPYBARISTA_SYNC_USER_NAME: @@SYNC_USER_NAME@@
      COPYBARISTA_SYNC_USER_EMAIL: @@SYNC_USER_EMAIL@@
      COPYBARISTA_SYNC_TOKEN_LOGIN: @@SYNC_TOKEN_LOGIN@@
      COPYBARISTA_AUTO_MERGE: ${{ vars.COPYBARISTA_AUTO_MERGE || 'false' }}
@@REPLAY_BOOTSTRAP_BASE_COMMENT@@      COPYBARISTA_REPLAY_BOOTSTRAP_BASE: ${{ inputs.replay_bootstrap_base@@REPLAY_BOOTSTRAP_BASE_DEFAULT@@ }}

    steps:
      - name: Verify sync token identity
        if: env.COPYBARISTA_SYNC_TOKEN_LOGIN != ''
        run: |
          token_login="$(gh api user --jq .login)"
          if [ "$token_login" != "$COPYBARISTA_SYNC_TOKEN_LOGIN" ]; then
            echo "::error::COPYBARISTA_SYNC_TOKEN authenticates as '$token_login', expected '$COPYBARISTA_SYNC_TOKEN_LOGIN'. Rotate COPYBARISTA_SYNC_TOKEN to a token owned by $COPYBARISTA_SYNC_TOKEN_LOGIN; git author settings cannot change GitHub push or PR attribution."
            exit 1
          fi
      - uses: @@USES_CHECKOUT@@
        with:
          path: source
          fetch-depth: 0
      - uses: @@USES_SETUP_PYTHON@@
        with:
          # Pin to the published floor (requires-python >=3.12), not the repo
          # default, so the export runs on the oldest interpreter downstream
          # users can install.
          python-version: @@PYTHON_VERSION@@
      - uses: @@USES_SETUP_UV@@
      - uses: @@USES_CHECKOUT@@
        with:
          repository: ${{ env.TARGET_REPO }}
          token: ${{ secrets.COPYBARISTA_SYNC_TOKEN }}
          ref: ${{ env.BASE_BRANCH }}
          path: public
          # Full history: the data-loss guard walks `<last-import>..HEAD` to see
          # whether anything unimported was written by someone other than the
          # export. A shallow clone cannot resolve that range, so the guard
          # fails closed and every export skips forever.
          fetch-depth: 0
@@SYSTEM_DEPS@@      - name: Open export PR
        env:
          PYTHONPATH: source
        run: |
          uv --quiet run --no-project --with pyyaml --with ruff python3 \
            @@SYNC_EXPORT_SCRIPT@@ \
            --source-dir source \
            --project-path @@SOURCE_ROOT@@ \
            --public-dir public \
            --target-repo "$TARGET_REPO" \
            --base-branch "$BASE_BRANCH" \
            --branch "$EXPORT_BRANCH" \
            --branch-prefix @@EXPORT_BRANCH_PREFIX@@ \
            --import-branch-prefix @@IMPORT_BRANCH_PREFIX@@ \
            --source-repo "${{ github.repository }}" \
            --sync-label "$SYNC_LABEL" \
@@PR_REPLAY_FLAGS@@ \
            --forbidden-pr-text "$FORBIDDEN_PR_TEXT" \
@@RELEASE_CHECK_ARG@@@@TYPE_TARGETS@@ \
@@VALIDATION_COMMANDS@@ \
            --smoke-import @@SMOKE_IMPORT@@ \
@@SKIP_SOURCE_VALIDATION_ARG@@            --auto-merge="$COPYBARISTA_AUTO_MERGE"
