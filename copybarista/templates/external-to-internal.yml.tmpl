name: @@WORKFLOW_NAME@@

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      public_base_ref:
        description: Public ref that represents the already-synced base tree.
        default: main
        required: true
      public_head_ref:
        description: Public ref to import. Defaults to this workflow run SHA.
        required: false

permissions:
  contents: read

concurrency:
  group: copybarista-import-${{ github.ref }}
  cancel-in-progress: false

jobs:
  import-change:
    name: @@JOB_NAME@@
    runs-on: ubuntu-latest
    # Bounded so a hung step fails in minutes, not at the 6h default.
    timeout-minutes: 45
    env:
      DISPATCH_PUBLIC_BASE_REF: ${{ inputs.public_base_ref }}
      DISPATCH_PUBLIC_HEAD_REF: ${{ inputs.public_head_ref }}
      TARGET_REPO: ${{ vars.COPYBARISTA_SOURCE_REPO }}
      TARGET_PROJECT_PATH: ${{ vars.COPYBARISTA_TARGET_PROJECT_PATH }}
      COPYBARISTA_TOOL_PROJECT_PATH: ${{ vars.COPYBARISTA_TOOL_PROJECT_PATH }}
      COPYBARISTA_IMPORT_BRANCH_PREFIX: @@IMPORT_BRANCH_PREFIX@@
      COPYBARISTA_SYNC_LABEL: @@SYNC_LABEL@@
      COPYBARISTA_SYNC_USER_NAME: @@SYNC_USER_NAME@@
      COPYBARISTA_SYNC_USER_EMAIL: @@SYNC_USER_EMAIL@@

    if: |
      github.event_name == 'workflow_dispatch' ||
      (
        github.event_name == 'pull_request' &&
        github.event.pull_request.head.repo.full_name == github.repository &&
        !startsWith(github.event.pull_request.head.ref, @@EXPORT_PREFIX_EXPR@@)
      ) ||
      (
        github.event_name == 'push' &&
        github.event.before != '0000000000000000000000000000000000000000' &&
        github.event.head_commit.author.email != @@SYNC_USER_EMAIL_EXPR@@ &&
        !contains(github.event.head_commit.message, @@EXPORT_PREFIX_EXPR@@) &&
        !contains(github.event.head_commit.message, @@EXPORT_BRANCH_MESSAGE_EXPR@@)
      )

    steps:
      - name: Set sync paths
        run: |
          echo "IMPORT_REPORT=$RUNNER_TEMP/copybarista-import-report.json" >> "$GITHUB_ENV"
          echo "TRUSTED_IMPORT_SCRIPT=$RUNNER_TEMP/sync_import_change.py" >> "$GITHUB_ENV"

      - id: settings
        name: Check settings
        env:
          IMPORT_TOKEN: ${{ secrets.COPYBARISTA_IMPORT_TOKEN }}
        run: |
          missing=false
          if [ -z "$IMPORT_TOKEN" ]; then
            echo "::error::Set COPYBARISTA_IMPORT_TOKEN with repo and workflow scopes."
            missing=true
          fi
          if [ -z "$TARGET_REPO" ]; then
            echo "::error::Set COPYBARISTA_SOURCE_REPO."
            missing=true
          fi
          if [ -z "$TARGET_PROJECT_PATH" ]; then
            echo "::error::Set COPYBARISTA_TARGET_PROJECT_PATH."
            missing=true
          fi
          if [ -z "$COPYBARISTA_TOOL_PROJECT_PATH" ]; then
            echo "::error::Set COPYBARISTA_TOOL_PROJECT_PATH."
            missing=true
          fi
          if [ "$missing" = "true" ]; then
            if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
              exit 1
            fi
            echo "::notice::Import back to loop is not configured; skipping."
            echo "enabled=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "enabled=true" >> "$GITHUB_OUTPUT"

      # The target checkout comes first because it carries the import ledger the
      # merge baseline is read from, and because the trusted helper is installed
      # out of it before any public tree exists on disk. It keeps
      # persist-credentials: false, so the import token is used for this fetch
      # and never written into target/.git/config where the later step that
      # executes imported public code could read it.
      - uses: @@USES_CHECKOUT@@
        if: steps.settings.outputs.enabled == 'true'
        with:
          repository: ${{ env.TARGET_REPO }}
          token: ${{ secrets.COPYBARISTA_IMPORT_TOKEN }}
          ref: main
          path: target
          persist-credentials: false
          # Full history: the baseline resolver walks this branch for the newest
          # landed import commit. A shallow clone sees one commit, so every
          # import would silently fall back to the pushed commit's parent -- the
          # exact wrong baseline this resolution exists to avoid.
          fetch-depth: 0
      - uses: @@USES_SETUP_PYTHON@@
        if: steps.settings.outputs.enabled == 'true'
        with:
          python-version: @@PYTHON_VERSION@@
      - uses: @@USES_SETUP_UV@@
        if: steps.settings.outputs.enabled == 'true'

      - name: Capture trusted import helper
        if: steps.settings.outputs.enabled == 'true'
        run: |
          install -m 600 \
            "target/$COPYBARISTA_TOOL_PROJECT_PATH/scripts/sync_import_change.py" \
            "$TRUSTED_IMPORT_SCRIPT"

      # The public repo (this repo) at FULL history, before the baseline is
      # resolved: the resolver walks it for the newest public commit the source
      # already reflects, which includes source->public EXPORTS that leave no
      # import-ledger entry in target. Without this a long export-only streak
      # yields a months-stale baseline and the three-way merge manufactures
      # conflicts (the 39-file incident). Shallow would see one commit and hide
      # every export.
      - uses: @@USES_CHECKOUT@@
        if: steps.settings.outputs.enabled == 'true'
        with:
          ref: main
          path: public-history
          persist-credentials: false
          fetch-depth: 0

      - id: refs
        name: Resolve public refs
        if: steps.settings.outputs.enabled == 'true'
        run: |
          if [ "${{ github.event_name }}" = "pull_request" ]; then
            base_ref="${{ github.event.pull_request.base.sha }}"
            head_ref="${{ github.event.pull_request.head.sha }}"
          elif [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            base_ref="$DISPATCH_PUBLIC_BASE_REF"
            head_ref="$DISPATCH_PUBLIC_HEAD_REF"
            if [ -z "$head_ref" ]; then
              head_ref="${GITHUB_SHA}"
            fi
          else
            # A push carries no explicit base, so read the baseline from the
            # public commit the source already reflects -- by EITHER path it
            # gets there. The target import ledger records landed imports; the
            # public-history checkout additionally surfaces source->public
            # exports, which leave NO ledger entry. github.event.before is only
            # the pushed commit's PARENT, and it diverges from the true baseline
            # the moment an import fails/goes unlanded OR an export lands with no
            # import between -- so a parent-based baseline feeds the merge a
            # wrong common ancestor and manufactures conflicts. It survives only
            # as the bootstrap for a target that has synced nothing yet.
            base_ref="$(uv --quiet run --no-project python \
              "$TRUSTED_IMPORT_SCRIPT" \
              --print-synced-base \
              --target-dir target \
              --public-dir public-history \
              --base-branch main \
              --sync-label "$COPYBARISTA_SYNC_LABEL" \
              --fallback-sha "${{ github.event.before }}")"
            head_ref="${GITHUB_SHA}"
          fi
          if [ -z "$base_ref" ] || [ "$base_ref" = "0000000000000000000000000000000000000000" ]; then
            echo "::error::Cannot resolve public base ref for import."
            exit 1
          fi
          for ref in "$base_ref" "$head_ref"; do
            if ! git check-ref-format --allow-onelevel "$ref"; then
              echo "::error::Invalid public ref: $ref"
              exit 1
            fi
          done
          echo "base_ref=$base_ref" >> "$GITHUB_OUTPUT"
          echo "head_ref=$head_ref" >> "$GITHUB_OUTPUT"

      - uses: @@USES_CHECKOUT@@
        if: steps.settings.outputs.enabled == 'true'
        with:
          ref: ${{ steps.refs.outputs.base_ref }}
          path: public-base
      - uses: @@USES_CHECKOUT@@
        if: steps.settings.outputs.enabled == 'true'
        with:
          ref: ${{ steps.refs.outputs.head_ref }}
          path: public-head

@@SYSTEM_DEPS@@      - name: Import public tree into target repository
        if: steps.settings.outputs.enabled == 'true'
        run: |
          public_base_ref="${{ steps.refs.outputs.base_ref }}"
          public_head_ref="${{ steps.refs.outputs.head_ref }}"
          uv --quiet run --no-project python \
            "$TRUSTED_IMPORT_SCRIPT" \
            --public-base public-base \
            --public-head public-head \
            --target-dir target \
            --target-repo "$TARGET_REPO" \
            --project-path "$TARGET_PROJECT_PATH" \
            --base-branch main \
            --public-repo "$GITHUB_REPOSITORY" \
            --public-sha "$GITHUB_SHA" \
            --public-base-ref "$public_base_ref" \
            --public-head-ref "$public_head_ref" \
            --branch-prefix "$COPYBARISTA_IMPORT_BRANCH_PREFIX" \
            --sync-label "$COPYBARISTA_SYNC_LABEL" \
            --report "$IMPORT_REPORT" \
@@REFRESH_PUBLIC_LOCKFILE_ARG@@@@VALIDATION_COMMANDS@@ \
            --open-pr false

      - name: Open or update target import PR
        if: steps.settings.outputs.enabled == 'true' && github.event_name != 'pull_request'
        env:
          GH_TOKEN: ${{ secrets.COPYBARISTA_IMPORT_TOKEN }}
        run: |
          public_base_ref="${{ steps.refs.outputs.base_ref }}"
          public_head_ref="${{ steps.refs.outputs.head_ref }}"
          # The target checkout uses persist-credentials: false so the import
          # token never reaches the validation step (which executes imported
          # public code). The PR step needs git auth to push the import branch,
          # so configure a token auth header scoped to this target checkout only.
          auth_header="$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)"
          git -C target config http."https://github.com/".extraheader \
            "AUTHORIZATION: basic $auth_header"
          uv --quiet run --no-project python "$TRUSTED_IMPORT_SCRIPT" \
            --target-dir target \
            --target-repo "$TARGET_REPO" \
            --project-path "$TARGET_PROJECT_PATH" \
            --base-branch main \
            --public-repo "$GITHUB_REPOSITORY" \
            --public-sha "$GITHUB_SHA" \
            --public-base-ref "$public_base_ref" \
            --public-head-ref "$public_head_ref" \
            --branch-prefix "$COPYBARISTA_IMPORT_BRANCH_PREFIX" \
            --sync-label "$COPYBARISTA_SYNC_LABEL" \
            --report "$IMPORT_REPORT" \
            --open-pr true \
            --auto-merge "${{ vars.COPYBARISTA_IMPORT_AUTO_MERGE || 'true' }}" \
            --open-pr-only

      - name: Upload import report
        if: always()
        uses: @@USES_UPLOAD_ARTIFACT@@
        with:
          name: copybarista-import-report
          path: ${{ env.IMPORT_REPORT }}
          if-no-files-found: ignore
